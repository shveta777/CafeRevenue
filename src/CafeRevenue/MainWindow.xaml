<Window x:Class="CafeRevenue.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CafeRevenue — Заказы" Width="1180" Height="820" MinWidth="1000" MinHeight="600"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F3F6F7" Foreground="#293D49" FontSize="15"
 Closing="Window_Closing">
 <DockPanel Background="#F3F6F7">
  <Border DockPanel.Dock="Top" Background="White" Padding="22,12">
   <DockPanel><Button x:Name="LogoutButton" DockPanel.Dock="Right" Content="Сменить пользователя" Click="Logout_Click" Padding="12,8"/>
    <TextBlock x:Name="UserText" DockPanel.Dock="Right" Margin="15,0,20,0" VerticalAlignment="Center"/>
    <TextBlock Text="CafeRevenue" Foreground="#167180" FontSize="26" FontWeight="Bold"/>
   </DockPanel>
  </Border>
  <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="22,10" TextWrapping="Wrap" MinHeight="35" Foreground="#167180"/>
  <TextBlock x:Name="AccessText" Margin="30" Text="Работа с заказами доступна кассиру и администратору.&#10;Нажмите «Сменить пользователя» и войдите под нужной учётной записью." FontSize="22" TextWrapping="Wrap" Visibility="Collapsed"/>
  <Grid x:Name="Workspace" Margin="22,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#E9F0F3" Padding="14" CornerRadius="8" Margin="0,0,0,14">
    <DockPanel><Button x:Name="CloseShiftButton" DockPanel.Dock="Right" Content="Закрыть смену" Click="CloseShift_Click" Padding="14,8" Margin="10,0,0,0"/>
     <Button x:Name="OpenShiftButton" DockPanel.Dock="Right" Content="Открыть смену" Click="OpenShift_Click" Padding="14,8"/>
     <TextBlock x:Name="ShiftText" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </DockPanel>
   </Border>
   <DockPanel Grid.Row="1" Margin="0,0,0,15">
    <Button x:Name="NewOrderButton" DockPanel.Dock="Right" Content="Новый заказ" Click="NewOrder_Click" Padding="14,8" Margin="12,0,0,0"/>
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" Padding="14,8" Margin="12,0,0,0"/>
    <TextBlock DockPanel.Dock="Left" Text="Мои заказы" FontSize="22" FontWeight="Bold" Margin="0,0,18,0" VerticalAlignment="Center"/>
    <ComboBox x:Name="OrderPicker" DisplayMemberPath="Display" SelectionChanged="OrderPicker_Changed"/>
   </DockPanel>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
    <Border Background="White" CornerRadius="8" Padding="14">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Меню" FontSize="23" FontWeight="Bold" Margin="0,0,0,12"/>
      <TextBox DockPanel.Dock="Top" x:Name="SearchBox" TextChanged="MenuFilter_Changed" ToolTip="Поиск блюда по названию" Margin="0,0,0,8"/>
      <ComboBox DockPanel.Dock="Top" x:Name="CategoryPicker" SelectionChanged="MenuFilter_Changed" Margin="0,0,0,12"/>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
       <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Добавить" Click="Add_Click" Padding="14,8"/>
       <TextBlock DockPanel.Dock="Left" Text="Количество" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBox x:Name="QuantityBox" Text="1" MaxLength="3" Width="65" HorizontalAlignment="Left"/>
      </DockPanel>
      <DataGrid x:Name="MenuGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="36" FontSize="14">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Блюдо" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}" Width="85"/>
        <DataGridTextColumn Header="Доступность" Binding="{Binding Availability}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14">
     <DockPanel>
      <TextBlock x:Name="OrderTitle" DockPanel.Dock="Top" Text="Новый заказ" FontSize="23" FontWeight="Bold" Margin="0,0,0,10"/>
      <ComboBox x:Name="TablePicker" DockPanel.Dock="Top" DisplayMemberPath="Name" SelectionChanged="TablePicker_Changed" Margin="0,0,0,12"/>
      <StackPanel DockPanel.Dock="Bottom">
       <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
        <Button x:Name="MinusButton" Content="−" Click="Minus_Click" Padding="15,6"/>
        <Button x:Name="PlusButton" Content="+" Click="Plus_Click" Padding="15,6" Margin="8,0,0,0"/>
        <Button x:Name="RemoveButton" Content="Удалить позицию" Click="Remove_Click" Padding="12,6" Margin="8,0,0,0"/>
       </StackPanel>
       <TextBlock x:Name="TotalText" FontSize="23" FontWeight="Bold" Margin="0,0,0,5"/>
       <TextBlock x:Name="DiscountText" Foreground="#6B7F8C" Margin="0,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="SaveOrderButton" Content="Сохранить заказ" Click="SaveOrder_Click" Margin="0,0,6,0" Padding="8,10"/>
        <Button x:Name="PayButton" Grid.Column="1" Content="Оплатить" Click="Pay_Click" Margin="6,0,0,0" Padding="8,10"/>
       </Grid>
      </StackPanel>
      <DataGrid x:Name="CartGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" RowHeight="36" FontSize="14">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Блюдо" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/>
        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}" Width="80"/>
        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N2}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
