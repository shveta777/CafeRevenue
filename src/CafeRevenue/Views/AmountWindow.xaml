<Window x:Class="CafeRevenue.Views.AmountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6F7" Foreground="#293D49" FontSize="16">
 <StackPanel Margin="25"><TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,18"/><TextBox x:Name="AmountBox" Text="0" MaxLength="16"/>
 <TextBlock x:Name="ErrorText" Foreground="#B33636" TextWrapping="Wrap" MinHeight="50" Margin="0,12,0,10"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="ConfirmButton" Content="Подтвердить" IsDefault="True" Click="Confirm_Click"/></StackPanel></StackPanel>
</Window>
