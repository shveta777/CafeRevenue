<Window x:Class="CafeRevenue.Views.PaymentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Оплата заказа" Width="540" Height="510" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6F7" Foreground="#293D49" FontSize="16" Closing="Window_Closing">
 <StackPanel Margin="26">
  <TextBlock x:Name="TitleText" FontSize="25" FontWeight="Bold" Margin="0,0,0,20"/>
  <TextBlock Text="Способ оплаты"/><ComboBox x:Name="MethodBox" SelectionChanged="InputChanged" Margin="0,8,0,18"><ComboBoxItem Content="Наличные"/><ComboBoxItem Content="Банковская карта"/></ComboBox>
  <StackPanel x:Name="CashPanel"><TextBlock Text="Получено наличными, ₽"/><TextBox x:Name="ReceivedBox" TextChanged="InputChanged" MaxLength="16" Margin="0,8,0,12"/><TextBlock x:Name="ChangeText" FontSize="20" FontWeight="SemiBold"/></StackPanel>
  <CheckBox x:Name="CardCheck" Content="Оплата на внешнем терминале прошла успешно" Visibility="Collapsed" Checked="InputChanged" Unchecked="InputChanged" Margin="0,10,0,12"/>
  <TextBlock x:Name="ErrorText" Foreground="#B33636" TextWrapping="Wrap" MinHeight="65" Margin="0,18,0,10"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,0,10,0"/><Button x:Name="PayButton" Content="Подтвердить оплату" Click="Pay_Click"/></StackPanel>
 </StackPanel>
</Window>
